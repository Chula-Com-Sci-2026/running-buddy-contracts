{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity email OTP job",
  "type": "object",
  "properties": {
    "channelType": {
      "const": "EMAIL"
    },
    "target": {
      "type": "string",
      "format": "email"
    },
    "subject": {
      "type": "string"
    },
    "templateType": {
      "enum": [
        "EMAIL_VERIFICATION",
        "PASSWORD_RESET"
      ]
    },
    "otpCode": {
      "type": "string",
      "pattern": "^\\d{6}$"
    }
  },
  "required": [
    "channelType",
    "target",
    "subject",
    "templateType",
    "otpCode"
  ]
}
