{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "BuddyRequestSent",
        "BuddyRequestAnswered"
      ]
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "senderId": {
          "type": "string",
          "format": "uuid"
        },
        "recipientId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        }
      },
      "required": [
        "requestId",
        "senderId",
        "recipientId",
        "status"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "version",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Buddy notification event v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "BuddyRequestSent"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "BuddyRequestAnswered"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "rejected"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
