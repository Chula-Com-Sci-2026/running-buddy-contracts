                    },
                    {
                      "$ref": "#/components/schemas/Message"
                    }
                  ]
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Sets or clears refreshToken; HttpOnly; SameSite=Lax; Path=/api/v1/auth. Secure in production or when configured.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification or missing input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OTP cooldown or attempts exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Service or delivery failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "registrationId plus code (or otpCode) returns a session and refresh cookie. phoneNumber without registrationId returns only a verification message.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneVerification"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email/send-otp": {
      "post": {
        "summary": "Send email verification OTP",
        "operationId": "email_send_otp",
        "responses": {
          "200": {
            "description": "Send email verification OTP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailOtpSent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification or missing input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Account not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Service or delivery failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Publishes an EMAIL_VERIFICATION job. OTP expires after five minutes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email/verify-otp": {
      "post": {
        "summary": "Verify email ownership",
        "operationId": "email_verify_otp",
        "responses": {
          "200": {
            "description": "Verify email ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification or missing input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OTP cooldown or attempts exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Service or delivery failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "otpCode": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "email",
                  "otpCode"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/request-password-reset": {
      "post": {
        "summary": "Request password reset OTP",
        "operationId": "request_password_reset",
        "responses": {
          "200": {
            "description": "Request password reset OTP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailOtpSent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification or missing input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Account locked or phone verification required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Service or delivery failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Returns a generic success message for unknown emails. OTP expires after 15 minutes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset": {
      "post": {
        "summary": "Reset password and revoke refresh sessions",
        "operationId": "password_reset",
        "responses": {
          "200": {
            "description": "Reset password and revoke refresh sessions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification or missing input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Account not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OTP cooldown or attempts exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Service or delivery failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "otpCode": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "required": [
                  "email",
                  "otpCode",
                  "newPassword"
                ]
              }
            }
          }
        }
      }
    },
    "/up": {
      "get": {
        "operationId": "health",
        "summary": "Check database connectivity",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Message": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "Error": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "success",
              "message"
            ]
          }
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "accessToken": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "profileComplete": {
            "type": "boolean",
            "description": "Currently always false; fetch Profile to determine completion."
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "isEmailVerified": {
                "type": "boolean"
              },
              "isPhoneVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "email",
              "isEmailVerified",
              "isPhoneVerified"
            ]
          }
        },
        "required": [
          "success",
          "accessToken",
          "userId",
          "profileComplete",
          "user"
        ]
      },
      "Registration": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "At most 72 UTF-8 bytes."
          },
          "phoneNumber": {
            "type": "string",
            "description": "Thai phone number; required unless REQUIRE_PHONE_VERIFICATION=false."
          },
          "pdpaConsent": {
            "type": "boolean",
            "description": "Explicit false is rejected."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Registered": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
