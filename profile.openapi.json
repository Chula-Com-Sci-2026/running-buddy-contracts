{
  "openapi": "3.1.0",
  "info": {
    "title": "Profile Service",
    "version": "1.0.0"
  },
  "paths": {
    "/up": {
      "get": {
        "summary": "Health",
        "operationId": "health_up_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
