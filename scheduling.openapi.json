  "components": {
    "schemas": {
      "CreateRun": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "meetingPoint": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Meetingpoint"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "time": {
            "type": "string",
            "title": "Time"
          },
          "distanceKm": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Distancekm"
          },
          "pace": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Pace"
          },
          "participantLimit": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 2.0,
            "title": "Participantlimit"
          },
          "visibility": {
            "type": "string",
            "const": "Public",
            "title": "Visibility",
            "default": "Public"
          }
        },
        "type": "object",
        "required": [
          "title",
          "meetingPoint",
          "latitude",
          "longitude",
          "date",
          "time",
          "distanceKm",
          "pace",
          "participantLimit"
        ],
        "title": "CreateRun"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
